// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleCode {
  REQUESTER
  TECHNICIAN
  SUPERVISOR
  ADMIN
}

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
}

enum TicketStatus {
  NEW
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  WAITING_REQUESTER
  RESOLVED
  CLOSED
  REJECTED
}

enum TicketImpact {
  LOW
  MEDIUM
  HIGH
}

enum TicketUrgency {
  LOW
  MEDIUM
  HIGH
}

enum TicketPriority {
  P1
  P2
  P3
  P4
}

enum TicketActivityType {
  STATUS
  COMMENT
}

enum TicketVisibility {
  PUBLIC
  INTERNAL
}

enum SlaEventType {
  RESPONSE_WARNING
  RESPONSE_BREACHED
  RESOLUTION_WARNING
  RESOLUTION_BREACHED
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  email            String           @unique
  fullName         String           @map("full_name")
  passwordHash     String           @map("password_hash")
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  userRoles        UserRole[]
  sessions         Session[]
  requestedTickets Ticket[]         @relation("TicketRequester")
  assignedTickets  Ticket[]         @relation("TicketAssignee")
  ticketActivities TicketActivity[]
  auditLogs        AuditLog[]
  notifications    Notification[]

  @@index([active])
  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        RoleCode   @unique
  name        String
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tickets   Ticket[]

  @@index([active])
  @@map("categories")
}

model Ticket {
  id             String           @id @default(uuid()) @db.Uuid
  code           String           @unique
  type           TicketType       @default(INCIDENT)
  title          String
  description    String           @db.Text
  impact         TicketImpact
  urgency        TicketUrgency
  priority       TicketPriority
  status         TicketStatus     @default(NEW)
  requesterId    String           @map("requester_id") @db.Uuid
  assigneeId     String?          @map("assignee_id") @db.Uuid
  categoryId     String           @map("category_id") @db.Uuid
  resolutionNote String?          @map("resolution_note") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  resolvedAt     DateTime?        @map("resolved_at")
  closedAt       DateTime?        @map("closed_at")
  version        Int              @default(1)
  requester      User             @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee       User?            @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  activities     TicketActivity[]
  ticketSla      TicketSla?
  slaEvents      SlaEvent[]
  auditLogs      AuditLog[]
  notifications  Notification[]

  @@index([requesterId])
  @@index([assigneeId])
  @@index([categoryId])
  @@index([status, priority])
  @@index([createdAt])
  @@map("tickets")
}

model TicketActivity {
  id         String             @id @default(uuid()) @db.Uuid
  ticketId   String             @map("ticket_id") @db.Uuid
  actorId    String?            @map("actor_id") @db.Uuid
  type       TicketActivityType
  visibility TicketVisibility   @default(PUBLIC)
  content    String?            @db.Text
  fromStatus TicketStatus?      @map("from_status")
  toStatus   TicketStatus?      @map("to_status")
  createdAt  DateTime           @default(now()) @map("created_at")
  ticket     Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor      User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, visibility, createdAt])
  @@map("ticket_activities")
}

model SlaPolicy {
  id                String         @id @default(uuid()) @db.Uuid
  priority          TicketPriority @unique
  responseMinutes   Int            @map("response_minutes")
  resolutionMinutes Int            @map("resolution_minutes")
  revision          Int            @default(1)
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  ticketSlas        TicketSla[]

  @@map("sla_policies")
}

model TicketSla {
  id                   String     @id @default(uuid()) @db.Uuid
  ticketId             String     @unique @map("ticket_id") @db.Uuid
  slaPolicyId          String?    @map("sla_policy_id") @db.Uuid
  policyRevision       Int        @default(1) @map("policy_revision")
  responseDueAt        DateTime   @map("response_due_at")
  resolutionDueAt      DateTime   @map("resolution_due_at")
  firstResponseAt      DateTime?  @map("first_response_at")
  lastResolvedAt       DateTime?  @map("last_resolved_at")
  responseBreachedAt   DateTime?  @map("response_breached_at")
  resolutionBreachedAt DateTime?  @map("resolution_breached_at")
  computedAt           DateTime   @default(now()) @map("computed_at")
  ticket               Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  slaPolicy            SlaPolicy? @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)

  @@index([responseDueAt])
  @@index([resolutionDueAt])
  @@map("ticket_sla")
}

model SlaEvent {
  id             String       @id @default(uuid()) @db.Uuid
  ticketId       String       @map("ticket_id") @db.Uuid
  eventType      SlaEventType @map("event_type")
  policyRevision Int          @default(1) @map("policy_revision")
  createdAt      DateTime     @default(now()) @map("created_at")
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, eventType, policyRevision])
  @@index([ticketId])
  @@map("sla_events")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  ticketId   String?  @map("ticket_id") @db.Uuid
  beforeJson String?  @map("before_json") @db.Text
  afterJson  String?  @map("after_json") @db.Text
  reason     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  ticket     Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([ticketId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  ticketId  String?   @map("ticket_id") @db.Uuid
  eventKey  String    @map("event_key")
  title     String
  message   String    @db.Text
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}
