// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleCode {
  REQUESTER
  TECHNICIAN
  SUPERVISOR
  ADMIN
}

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
}

enum TicketStatus {
  NEW
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  WAITING_REQUESTER
  RESOLVED
  CLOSED
  REJECTED
}

enum TicketImpact {
  LOW
  MEDIUM
  HIGH
}

enum TicketUrgency {
  LOW
  MEDIUM
  HIGH
}

enum TicketPriority {
  P1
  P2
  P3
  P4
}

enum TicketActivityType {
  STATUS
  COMMENT
}

enum TicketVisibility {
  PUBLIC
  INTERNAL
}

enum SlaEventType {
  RESPONSE_WARNING
  RESPONSE_BREACHED
  RESOLUTION_WARNING
  RESOLUTION_BREACHED
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_MAINTENANCE
  RETIRED
  DISPOSED
  LOST
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AssetMaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssetMaintenanceType {
  REPAIR
  MAINTENANCE
  UPGRADE
  INSPECTION
}

enum AssetHistoryAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  RETURNED
  MAINTENANCE_CREATED
  MAINTENANCE_UPDATED
  DELETED
}

enum RemoteSessionStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeviceVerificationStatus {
  PENDING
  VERIFIED
  REVOKED
}

model User {
  id               String             @id @default(uuid()) @db.Uuid
  email            String             @unique
  fullName         String             @map("full_name")
  passwordHash     String             @map("password_hash")
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  userRoles        UserRole[]
  sessions         Session[]
  requestedTickets Ticket[]           @relation("TicketRequester")
  assignedTickets  Ticket[]           @relation("TicketAssignee")
  ticketActivities TicketActivity[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  assetAssignments AssetAssignment[]  @relation("AssetAssignedTo")
  assignmentsMade  AssetAssignment[]  @relation("AssetAssignedBy")
  returnsMade      AssetAssignment[]  @relation("AssetReturnedBy")
  assetMaintenance AssetMaintenance[] @relation("AssetMaintenanceCreator")
  assetHistory     AssetHistory[]
  devices                  UserDevice[]
  requestedRemoteSessions  RemoteSupportSession[] @relation("RemoteSessionRequester")
  technicianRemoteSessions RemoteSupportSession[] @relation("RemoteSessionTechnician")

  @@index([active])
  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        RoleCode   @unique
  name        String
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tickets   Ticket[]

  @@index([active])
  @@map("categories")
}

model AssetCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  assets      Asset[]

  @@index([active, name])
  @@map("asset_categories")
}

model Asset {
  id              String             @id @default(uuid()) @db.Uuid
  assetTag        String             @unique @map("asset_tag")
  name            String
  categoryId      String             @map("category_id") @db.Uuid
  manufacturer    String?
  model           String?
  serialNumber    String?            @unique @map("serial_number")
  status          AssetStatus        @default(AVAILABLE)
  sharedReportable Boolean            @default(false) @map("shared_reportable")
  condition       AssetCondition     @default(GOOD)
  purchaseDate    DateTime?          @map("purchase_date") @db.Date
  purchaseCost    Decimal?           @map("purchase_cost") @db.Decimal(12, 2)
  warrantyExpires DateTime?          @map("warranty_expires") @db.Date
  location        String?
  notes           String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")
  category        AssetCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignments     AssetAssignment[]
  maintenance     AssetMaintenance[]
  history         AssetHistory[]
  tickets         Ticket[]

  @@index([categoryId, status])
  @@index([status, deletedAt])
  @@index([name])
  @@map("assets")
}

model AssetAssignment {
  id                    String          @id @default(uuid()) @db.Uuid
  assetId               String          @map("asset_id") @db.Uuid
  userId                String          @map("user_id") @db.Uuid
  assignedById          String          @map("assigned_by_id") @db.Uuid
  returnedById          String?         @map("returned_by_id") @db.Uuid
  assignedAt            DateTime        @default(now()) @map("assigned_at")
  returnedAt            DateTime?       @map("returned_at")
  notes                 String?         @db.Text
  returnNotes           String?         @map("return_notes") @db.Text
  conditionAtAssignment AssetCondition? @map("condition_at_assignment")
  conditionAtReturn     AssetCondition? @map("condition_at_return")
  asset                 Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  user                  User            @relation("AssetAssignedTo", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy            User            @relation("AssetAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  returnedBy            User?           @relation("AssetReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)

  @@index([assetId, returnedAt, assignedAt])
  @@index([userId, returnedAt])
  @@map("asset_assignments")
}

model AssetMaintenance {
  id          String                 @id @default(uuid()) @db.Uuid
  assetId     String                 @map("asset_id") @db.Uuid
  createdById String                 @map("created_by_id") @db.Uuid
  title       String
  type        AssetMaintenanceType   @default(MAINTENANCE)
  description String?                @db.Text
  diagnosis   String?                @db.Text
  resolution  String?                @db.Text
  notes       String?                @db.Text
  provider    String?
  cost        Decimal?               @db.Decimal(12, 2)
  status      AssetMaintenanceStatus @default(SCHEDULED)
  scheduledAt DateTime?              @map("scheduled_at")
  startedAt   DateTime?              @map("started_at")
  completedAt DateTime?              @map("completed_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  asset       Asset                  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  createdBy   User                   @relation("AssetMaintenanceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([assetId, createdAt])
  @@index([status, scheduledAt])
  @@map("asset_maintenance")
}

model AssetHistory {
  id        String             @id @default(uuid()) @db.Uuid
  assetId   String             @map("asset_id") @db.Uuid
  actorId   String?            @map("actor_id") @db.Uuid
  action    AssetHistoryAction
  details   Json?
  createdAt DateTime           @default(now()) @map("created_at")
  asset     Asset              @relation(fields: [assetId], references: [id], onDelete: Restrict)
  actor     User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
  @@index([actorId])
  @@map("asset_history")
}

model Ticket {
  id             String           @id @default(uuid()) @db.Uuid
  code           String           @unique
  type           TicketType       @default(INCIDENT)
  title          String
  description    String           @db.Text
  impact         TicketImpact
  urgency        TicketUrgency
  priority       TicketPriority
  status         TicketStatus     @default(NEW)
  requesterId    String           @map("requester_id") @db.Uuid
  assigneeId     String?          @map("assignee_id") @db.Uuid
  categoryId     String           @map("category_id") @db.Uuid
  assetId        String?          @map("asset_id") @db.Uuid
  resolutionNote String?          @map("resolution_note") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  resolvedAt     DateTime?        @map("resolved_at")
  closedAt       DateTime?        @map("closed_at")
  version        Int              @default(1)
  requester      User             @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee       User?            @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  asset          Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  activities     TicketActivity[]
  ticketSla      TicketSla?
  slaEvents      SlaEvent[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  remoteSupportRequested Boolean                @default(false) @map("remote_support_requested")
  preferredDeviceId      String?                @map("preferred_device_id") @db.Uuid
  preferredDevice        UserDevice?            @relation("TicketPreferredDevice", fields: [preferredDeviceId], references: [id], onDelete: SetNull)
  remoteSessions         RemoteSupportSession[]

  @@index([requesterId])
  @@index([assigneeId])
  @@index([categoryId])
  @@index([assetId])
  @@index([preferredDeviceId])
  @@index([status, priority])
  @@index([createdAt])
  @@map("tickets")
}

model TicketActivity {
  id         String             @id @default(uuid()) @db.Uuid
  ticketId   String             @map("ticket_id") @db.Uuid
  actorId    String?            @map("actor_id") @db.Uuid
  type       TicketActivityType
  visibility TicketVisibility   @default(PUBLIC)
  content    String?            @db.Text
  fromStatus TicketStatus?      @map("from_status")
  toStatus   TicketStatus?      @map("to_status")
  createdAt  DateTime           @default(now()) @map("created_at")
  ticket     Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor      User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, visibility, createdAt])
  @@map("ticket_activities")
}

model SlaPolicy {
  id                String         @id @default(uuid()) @db.Uuid
  priority          TicketPriority @unique
  responseMinutes   Int            @map("response_minutes")
  resolutionMinutes Int            @map("resolution_minutes")
  revision          Int            @default(1)
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  ticketSlas        TicketSla[]

  @@map("sla_policies")
}

model TicketSla {
  id                      String     @id @default(uuid()) @db.Uuid
  ticketId                String     @unique @map("ticket_id") @db.Uuid
  slaPolicyId             String?    @map("sla_policy_id") @db.Uuid
  policyRevision          Int        @default(1) @map("policy_revision")
  responseTargetMinutes   Int?       @map("response_target_minutes")
  resolutionTargetMinutes Int?       @map("resolution_target_minutes")
  responseDueAt           DateTime   @map("response_due_at")
  resolutionDueAt         DateTime   @map("resolution_due_at")
  firstResponseAt         DateTime?  @map("first_response_at")
  lastResolvedAt          DateTime?  @map("last_resolved_at")
  responseBreachedAt      DateTime?  @map("response_breached_at")
  resolutionBreachedAt    DateTime?  @map("resolution_breached_at")
  computedAt              DateTime   @default(now()) @map("computed_at")
  ticket                  Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  slaPolicy               SlaPolicy? @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)

  @@index([responseDueAt])
  @@index([resolutionDueAt])
  @@map("ticket_sla")
}

model SlaEvent {
  id             String       @id @default(uuid()) @db.Uuid
  ticketId       String       @map("ticket_id") @db.Uuid
  eventType      SlaEventType @map("event_type")
  policyRevision Int          @default(1) @map("policy_revision")
  createdAt      DateTime     @default(now()) @map("created_at")
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, eventType, policyRevision])
  @@index([ticketId])
  @@map("sla_events")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  ticketId   String?  @map("ticket_id") @db.Uuid
  beforeJson String?  @map("before_json") @db.Text
  afterJson  String?  @map("after_json") @db.Text
  reason     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  ticket     Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([ticketId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  ticketId  String?   @map("ticket_id") @db.Uuid
  eventKey  String    @map("event_key")
  title     String
  message   String    @db.Text
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model UserDevice {
  id                  String                   @id @default(uuid()) @db.Uuid
  ownerId             String                   @map("owner_id") @db.Uuid
  label               String
  rustdeskId          String                   @unique @map("rustdesk_id")
  osName              String?                  @map("os_name")
  verificationStatus  DeviceVerificationStatus @default(PENDING) @map("verification_status")
  active              Boolean                  @default(true)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  owner               User                     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  preferredForTickets Ticket[]                 @relation("TicketPreferredDevice")
  remoteSessions      RemoteSupportSession[]

  @@index([ownerId, active])
  @@map("user_devices")
}

model RemoteSupportSession {
  id                String              @id @default(uuid()) @db.Uuid
  ticketId          String              @map("ticket_id") @db.Uuid
  deviceId          String              @map("device_id") @db.Uuid
  requesterId       String              @map("requester_id") @db.Uuid
  technicianId      String              @map("technician_id") @db.Uuid
  status            RemoteSessionStatus @default(REQUESTED)
  requestNote       String?             @map("request_note") @db.Text
  rejectionReason   String?             @map("rejection_reason") @db.Text
  cancelReason      String?             @map("cancel_reason") @db.Text
  resultSummary     String?             @map("result_summary") @db.Text
  requestedAt       DateTime            @default(now()) @map("requested_at")
  approvedAt        DateTime?           @map("approved_at")
  approvalExpiresAt DateTime?           @map("approval_expires_at")
  rejectedAt        DateTime?           @map("rejected_at")
  startedAt         DateTime?           @map("started_at")
  endedAt           DateTime?           @map("ended_at")
  ticket            Ticket              @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  device            UserDevice          @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  requester         User                @relation("RemoteSessionRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  technician        User                @relation("RemoteSessionTechnician", fields: [technicianId], references: [id], onDelete: Restrict)

  @@index([ticketId, requestedAt])
  @@index([deviceId, status])
  @@index([requesterId, status])
  @@index([technicianId, status])
  @@index([status, requestedAt])
  @@map("remote_support_sessions")
}

model RustdeskServerConfig {
  id                 String   @id @default(uuid()) @db.Uuid
  singletonKey       String   @unique @default("PRIMARY") @map("singleton_key")
  idServerHost       String   @map("id_server_host")
  relayServerHost    String   @map("relay_server_host")
  publicKey          String?  @map("public_key")
  approvalTtlMinutes Int      @default(15) @map("approval_ttl_minutes")
  clientGuideUrl     String?  @map("client_guide_url")
  enabled            Boolean  @default(false)
  updatedById        String?  @map("updated_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("rustdesk_server_configs")
}
